# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Exemplo exclusivamente local. Copie para apps/backend/.env.
NODE_ENV=development
PORT=3000
PUBLIC_FRONTEND_ORIGINS=http://localhost:4200
BACKOFFICE_FRONTEND_ORIGINS=http://localhost:4300
ADMIN_INVITATION_TTL_HOURS=24
ADMIN_INVITATION_URL=http://localhost:4300/admin/activate
FAVORITES_MVP=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Em containers, substitua localhost pelo nome do serviço postgres_db.
# URL quando estiver fora do docker
DATABASE_URL="postgresql://admin:taskgo_local_only@localhost:5432/taskgo?schema=public"
JWT_SECRET="replace-with-a-random-local-secret"
EXPIRES_IN="1d"
CDN_EMAIL=""
CDN_PASSWORD=""
CDN_ACCOUNT_ID=""
CDN_TOKEN=""
CDN_API_TOKEN=""
CDN_BASE_URL=""
CDN_HASH=""

PAGARME_SECRET_KEY=""
PAGARME_BASE_URL="https://api.pagar.me/core/v5"
DEFAULT_PLATFORM_FEE_PCT="0.12"
PAGARME_PLATFORM_RECIPIENT_ID=""
PAYMENTS_SIMULATION="true"
# produção:
# PAGARME_BASE_URL=https://api.pagar.me/core/v5


ENV=""
SALT_ROUNDS="10"

# Recuperação de acesso: configure um transporte SMTP de homologação/produção.
# Nunca coloque credenciais reais no repositório. Sem estas variáveis a rota responde 503.
SMTP_URL=
MAIL_FROM=
PASSWORD_RESET_FRONTEND_URL=http://localhost:4200/authenticate/reset-password
# Seed com contas de demonstração exige opt-in e nunca executa em NODE_ENV=production.
ALLOW_DEMO_SEED=false
