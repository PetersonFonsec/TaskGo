{
  "name": "taskgo-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/backoffice",
    "apps/frontend",
    "apps/landing-page",
    "libs/*"
  ],
  "scripts": {
    "nx": "nx",
    "backend": "nx serve backend",
    "backoffice": "nx serve backoffice",
    "backoffice:build": "nx build backoffice",
    "backoffice:test": "nx test backoffice",
    "backoffice:e2e": "nx e2e backoffice",
    "frontend": "nx serve frontend",
    "landing-page": "nx serve landing-page",
    "landing-page:build": "nx build landing-page",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@nx/js": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "~4.1.0",
    "nx": "23.2.1",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "dependencies": {},
  "overrides": {
    "webpack-dev-middleware": "^7.4.5",
    "qs": "^6.16.0",
    "js-yaml@>=5.0.0": "^5.4.2",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "electron-to-chromium": "1.5.441",
    "axios": "^1.20.0",
    "brace-expansion@>=4.0.0": "^5.0.12",
    "smol-toml": "^1.9.0"
  }
}
